PORT=5000
# Replace with your MongoDB connection string (do NOT commit secrets)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/dsa?retryWrites=true&w=majority
# Use a long, random string in production
JWT_SECRET=your_jwt_secret_here
# Frontend origin for CORS
CLIENT_ORIGIN=http://localhost:3000
# Cookie settings
COOKIE_SECURE=false  # set to true in production (requires HTTPS)
COOKIE_SAME_SITE=lax  # set to 'none' if cookies must be sent cross-site in production
